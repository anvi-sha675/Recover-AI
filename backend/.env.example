# Server
PORT=4000

# AI Service (FastAPI) — must be running for /api/recovery/analyze|decide|execute to work
AI_SERVICE_URL=http://localhost:8000

# Razorpay Test Mode (get these from https://dashboard.razorpay.com in Test Mode)
# If left blank, the backend runs in an honest SIMULATED mode and labels every
# action accordingly — see services/razorpayService.js.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: enables real LLM narration of AI decisions (ai-service/llm_reasoner.py).
# If unset, the AI service falls back to a deterministic template built from
# the same evidence - it will not fabricate an LLM response.
ANTHROPIC_API_KEY=

# Optional: MongoDB Atlas connection string for production use.
# This build ships with a JSON-file store (backend/db/store.js) as an
# honest substitute since this sandbox has no live MongoDB access.
MONGODB_URI=

# Optional: gates state-changing endpoints (approve/reject/execute a policy
# change) behind a required `x-api-key` header, with role differentiation:
# REVIEWER can approve/reject; ADMIN can additionally update policy and
# trigger evaluation runs. If NEITHER key below is set, these endpoints
# are open (demo mode) and the server logs a warning at boot saying so.
# NOTE: the bundled frontend UI's Settings page can supply a key, but there
# is no full login/session system - this is a demo-grade RBAC gate.
REVIEWER_API_KEY=
ADMIN_API_KEY=

# Optional: enables real HMAC-SHA256 signature verification on
# POST /api/webhooks/razorpay (the exact algorithm Razorpay documents).
# Without this set, the webhook endpoint honestly returns 501 rather than
# accepting unverifiable events.
RAZORPAY_WEBHOOK_SECRET=
